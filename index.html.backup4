<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>DroidCraft</title>
  <style>
    /* --- GLOBAL SMOOTHNESS & PREMIUM FEEL --- */
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      transition: all 0.3s ease-in-out;
    }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background-color: #0f111a;
      color: #ffffff;
      margin: 0;
      padding: 0;
      overscroll-behavior: none;
      -webkit-font-smoothing: antialiased;
      -webkit-overflow-scrolling: touch;
    }
    .app-container { padding: 16px; padding-bottom: 80px; }

    /* --- PREMIUM BACK BUTTON --- */
    .premium-back-btn {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 42px; height: 42px;
      display: flex; align-items: center; justify-content: center;
      color: #fff; cursor: pointer;
      box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }
    .premium-back-btn:active { transform: scale(0.95); }

    /* --- AUTO-SCROLLING BANNER --- */
    .carousel-container {
      position: relative; width: 100%; height: 150px;
      border-radius: 16px; overflow: hidden; margin-bottom: 24px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }
    .carousel-track { display: flex; height: 100%; transition: transform 0.5s ease-in-out; }
    .carousel-slide { min-width: 100%; padding: 24px; display: flex; flex-direction: column; justify-content: center; }
    .slide-1 { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .slide-2 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
    .slide-3 { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
    .carousel-slide h2 { margin: 0 0 8px 0; font-size: 20px; }
    .carousel-slide p { margin: 0; opacity: 0.9; font-size: 13px; }
    .carousel-dots { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; }
    .dot { width: 6px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 50%; }
    .dot.active { background: #fff; width: 16px; border-radius: 4px; }

    /* --- PREMIUM USER GUIDE --- */
    .guide-container { padding: 16px; background: #0f111a; }
    .guide-header h1 { font-size: 22px; font-weight: 800; margin-bottom: 6px; }
    .guide-header p { color: #a0a4b8; font-size: 13px; margin-bottom: 20px; line-height: 1.5; }
    .step-card { display: flex; background: #1c1f2e; border-radius: 14px; padding: 16px; margin-bottom: 12px; border: 1px solid rgba(255,255,255,0.05); }
    .step-badge { background: #5b4df0; color: #fff; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 13px; margin-right: 14px; flex-shrink: 0; }
    .step-content h3 { font-size: 15px; margin: 0 0 8px 0; color: #fff; }
    .step-content ul { padding-left: 16px; margin: 0; color: #a0a4b8; font-size: 13px; line-height: 1.5; }

    /* --- EDIT PROFILE FORM --- */
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 12px; color: #a0a4b8; margin-bottom: 6px; text-transform: uppercase; font-weight: 600; }
    .form-input { width: 100%; padding: 12px; background: #1c1f2e; border: 1px solid #2a2e42; border-radius: 10px; color: #fff; font-size: 14px; outline: none; }
    .form-input:focus { border-color: #5b4df0; }
    .save-btn { background: #5b4df0; color: white; border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600; width: 100%; cursor: pointer; margin-top: 10px; }

    /* --- DASHBOARD CARDS --- */
    .section-title { font-size: 12px; font-weight: 700; color: #6c7293; text-transform: uppercase; letter-spacing: 1px; margin: 24px 0 12px 0; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .card { background: #1c1f2e; border-radius: 16px; padding: 16px; text-align: center; border: 1px solid rgba(255,255,255,0.03); cursor: pointer; }
    .card:active { transform: scale(0.98); background: #24283b; }
    .card-icon { font-size: 24px; margin-bottom: 8px; display: block; }
    .card-title { font-size: 14px; font-weight: 600; margin: 0; }
    .card-sub { font-size: 11px; color: #6c7293; margin-top: 4px; }

    /* --- BOTTOM NAV --- */
    .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; height: 60px; background: #1c1f2e; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid rgba(255,255,255,0.05); z-index: 100; }
    .nav-item { color: #6c7293; font-size: 20px; cursor: pointer; padding: 10px 20px; }
    .nav-item.active { color: #5b4df0; }
  </style>
</head>
<body>

  <!-- SCREEN 1: MAIN DASHBOARD -->
  <div id="mainScreen" class="app-container">
    <h1 style="font-size: 24px; margin-bottom: 4px;">Hi, Aaqib Alee'h 👋</h1>
    <p style="color: #a0a4b8; font-size: 13px; margin-bottom: 20px;">What would you like to build today?</p>

    <!-- AUTO-SCROLLING BANNER -->
    <div class="carousel-container">
      <div class="carousel-track" id="carouselTrack">
        <div class="carousel-slide slide-1"><h2>Build Fast ⚡</h2><p>Create an app in under 10 minutes.</p></div>
        <div class="carousel-slide slide-2"><h2>AI Assistant 🤖</h2><p>Let AI write your app logic for you.</p></div>
        <div class="carousel-slide slide-3"><h2>Export to Termux 📦</h2><p>Run your APK directly from your phone.</p></div>
      </div>
      <div class="carousel-dots"><span class="dot active"></span><span class="dot"></span><span class="dot"></span></div>
    </div>

    <div class="section-title">Quick Templates</div>
    <div class="grid-2">
      <div class="card" onclick="alert('Template selected!')"><span class="card-icon">🔐</span><p class="card-title">Login Screen</p></div>
      <div class="card" onclick="alert('Template selected!')"><span class="card-icon">📋</span><p class="card-title">Simple Form</p></div>
      <div class="card" onclick="alert('Template selected!')"><span class="card-icon">👋</span><p class="card-title">Welcome Page</p></div>
      <div class="card" onclick="alert('Template selected!')"><span class="card-icon">⬜</span><p class="card-title">Blank Canvas</p></div>
    </div>

    <div class="section-title">Explore More</div>
    <div class="grid-2">
      <div class="card" onclick="alert('Chat App started')"><span class="card-icon">💬</span><p class="card-title">Chat App</p><p class="card-sub">Messaging layout</p></div>
      <div class="card" onclick="showScreen('editProfileScreen')"><span class="card-icon">👤</span><p class="card-title">Profile</p><p class="card-sub">User profile page</p></div>
    </div>
    
    <div class="section-title">Quick Tools</div>
    <div class="grid-2">
      <div class="card" onclick="alert('Icons tool')"><span class="card-icon">😊</span><p class="card-title">Icons</p></div>
      <div class="card" onclick="alert('Colors tool')"><span class="card-icon">🎨</span><p class="card-title">Colors</p></div>
      <div class="card" onclick="alert('Names tool')"><span class="card-icon">💡</span><p class="card-title">Names</p></div>
      <div class="card" onclick="alert('Backup tool')"><span class="card-icon">💾</span><p class="card-title">Backup</p></div>
    </div>
  </div>

  <!-- SCREEN 2: EDIT PROFILE -->
  <div id="editProfileScreen" class="app-container" style="display: none;">
    <div style="display: flex; align-items: center; margin-bottom: 24px;">
      <button class="premium-back-btn" onclick="showScreen('mainScreen')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <h2 style="margin: 0 0 0 16px; font-size: 18px;">Edit Profile</h2>
    </div>

    <div style="text-align: center; margin-bottom: 24px;">
      <div style="width: 80px; height: 80px; background: #5b4df0; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: bold;">A</div>
    </div>

    <div class="form-group">
      <label>Full Name</label>
      <input type="text" class="form-input" id="fullName" value="Aaqib Alee'h">
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" class="form-input" id="email" value="miraqibalitalpur123@gmail.com">
    </div>
    <div class="form-group">
      <label>Bio</label>
      <textarea class="form-input" id="bio" rows="3" placeholder="A short line about you..."></textarea>
    </div>
    
    <!-- MANUAL SAVE BUTTON -->
    <button class="save-btn" onclick="saveProfile()">Save Changes</button>
  </div>

  <!-- SCREEN 3: USER GUIDE -->
  <div id="userGuideScreen" class="app-container" style="display: none;">
    <div style="display: flex; align-items: center; margin-bottom: 16px;">
      <button class="premium-back-btn" onclick="showScreen('mainScreen')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <h2 style="margin: 0 0 0 16px; font-size: 18px;">📚 User Guide</h2>
    </div>
    
    <div class="guide-container">
      <div class="guide-header">
        <h1>Welcome to DroidCraft 🚀</h1>
        <p>Turn your ideas into real Android apps — no coding needed.</p>
      </div>
      <div class="step-card">
        <div class="step-badge">1</div>
        <div class="step-content"><h3>🎨 Design Your App</h3><ul><li>Tap <b>New App</b> or pick a template.</li><li>Add Buttons, Text, and Inputs.</li></ul></div>
      </div>
      <div class="step-card">
        <div class="step-badge">2</div>
        <div class="step-content"><h3>📱 Style & Screens</h3><ul><li>Add multiple screens (Login, Home).</li><li>Long-press tabs to reorder.</li></ul></div>
      </div>
      <div class="step-card">
        <div class="step-badge">3</div>
        <div class="step-content"><h3>📦 Publish Your App</h3><ul><li>Tap <b>Publish</b> in the top right.</li><li>Build Real APK.</li></ul></div>
      </div>
    </div>
  </div>

  <!-- BOTTOM NAVIGATION -->
  <div class="bottom-nav">
    <div class="nav-item active" onclick="showScreen('mainScreen')">🏠</div>
    <div class="nav-item" onclick="showScreen('editProfileScreen')">👤</div>
    <div class="nav-item" onclick="showScreen('userGuideScreen')">📚</div>
  </div>

  <script>
    // --- SCREEN NAVIGATION ---
    function showScreen(screenId) {
      document.getElementById('mainScreen').style.display = 'none';
      document.getElementById('editProfileScreen').style.display = 'none';
      document.getElementById('userGuideScreen').style.display = 'none';
      document.getElementById(screenId).style.display = 'block';
      
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
      if(screenId === 'mainScreen') document.querySelectorAll('.nav-item')[0].classList.add('active');
      if(screenId === 'editProfileScreen') document.querySelectorAll('.nav-item')[1].classList.add('active');
      if(screenId === 'userGuideScreen') document.querySelectorAll('.nav-item')[2].classList.add('active');
    }

    // --- MANUAL SAVE LOGIC ---
    function saveProfile() {
      const name = document.getElementById('fullName').value;
      const email = document.getElementById('email').value;
      const bio = document.getElementById('bio').value;
      localStorage.setItem('userProfile', JSON.stringify({ name, email, bio }));
      alert('Profile saved successfully! ✅');
      showScreen('mainScreen');
    }

    // Load saved data on startup
    window.onload = () => {
      const saved = localStorage.getItem('userProfile');
      if (saved) {
        const data = JSON.parse(saved);
        if(data.name) document.getElementById('fullName').value = data.name;
        if(data.email) document.getElementById('email').value = data.email;
        if(data.bio) document.getElementById('bio').value = data.bio;
      }
    };

    // --- AUTO-SCROLLING BANNER LOGIC ---
    let currentSlide = 0;
    const track = document.getElementById('carouselTrack');
    const dots = document.querySelectorAll('.dot');
    if(track) {
      setInterval(() => {
        currentSlide = (currentSlide + 1) % 3;
        track.style.transform = `translateX(-${currentSlide * 100}%)`;
        dots.forEach((dot, index) => dot.classList.toggle('active', index === currentSlide));
      }, 3500);
    }
  </script>
</body>
</html>
